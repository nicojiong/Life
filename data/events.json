[
  {"id": "drought", "name": "旱", "min_age": 8, "weight": 3, "cooldown": 60,
   "text": "春旱，河断了流。粮价涨了三成，家里先紧着吃。",
   "effects": {"money": -700, "health": -3}},
  {"id": "flood", "name": "水", "min_age": 8, "weight": 3, "cooldown": 60,
   "text": "夏水暴涨，冲了低处的田。修堤又摊了一笔钱。",
   "effects": {"money": -900}},
  {"id": "levy", "name": "加赋", "min_age": 12, "weight": 4, "cooldown": 24,
   "text": "官府加派杂税，里正挨家收钱。",
   "effects": {"money": -500, "fame": -1}},
  {"id": "thieves", "name": "盗", "min_age": 12, "weight": 2, "cooldown": 36,
   "text": "夜里进了贼，翻走了箱底的现钱。",
   "effects": {"money": -600, "health": -2}},
  {"id": "plague", "name": "疫", "min_age": 10, "weight": 1, "cooldown": 120,
   "text": "疫气进了村。"},
  {"id": "suit", "name": "讼", "min_age": 16, "weight": 3, "cooldown": 24,
   "text": "被人告了一状，赔钱不说，还落了个不是。",
   "effects": {"money": -800, "fame": -2}},
  {"id": "wedding", "name": "婚嫁", "min_age": 10, "weight": 3, "cooldown": 36,
   "text": "邻家嫁女，随了三百文的礼。席上吃了两碗。",
   "effects": {"money": -300, "fame": 3}},
  {"id": "harvest", "name": "丰年", "min_age": 16, "cond": "farm", "weight": 4, "cooldown": 12,
   "text": "今年风雨应时。"},
  {"id": "reward", "name": "旌表", "min_age": 20, "cond": "famous", "weight": 2, "cooldown": 36,
   "text": "县里旌表善行，赏了一千二百文。",
   "effects": {"money": 1200, "fame": 8}},
  {"id": "school", "name": "入学", "min_age": 25, "cond": "parent", "weight": 2, "cooldown": 60,
   "text": "孩子到了开蒙的年纪，束脩又是一笔。",
   "effects": {"money": -500, "fame": 2}},
  {"id": "rash", "name": "疹", "min_age": 1, "max_age": 6, "weight": 2, "cooldown": 12,
   "text": "你出了一身疹子，母亲守了三夜，用凉水给你擦身。",
   "effects": {"health": -3, "story": "出疹子"}},
  {"id": "riverfall", "name": "落水", "min_age": 2, "max_age": 7, "weight": 2, "cooldown": 12,
   "text": "你掉进河里，被撑船的捞了上来。母亲抱着你哭了很久。",
   "effects": {"health": -2, "fame": 1, "story": "落水"}},
  {"id": "find_coin", "name": "拾钱", "min_age": 3, "max_age": 8, "weight": 2, "cooldown": 12,
   "text": "你在墙根下捡到一枚铜钱，攥了一天，最后还是交给了母亲。",
   "effects": {"money": 50}},
  {"id": "quarrel", "name": "口角", "min_age": 3, "max_age": 9, "weight": 2, "cooldown": 12,
   "text": "你和邻家孩子打了一架，回来挨了骂。",
   "effects": {"fame": -1, "health": -1}},
  {"id": "temple_fair", "name": "庙会", "min_age": 4, "weight": 3, "cooldown": 18,
   "text": "庙会上人挤人，你攥着母亲给的几文钱，买了一串糖葫芦。",
   "effects": {"money": 30, "fame": 2}},

  {"id": "first_steps", "name": "学步", "min_age": 1, "max_age": 3, "weight": 3, "cooldown": 6,
   "text": "你扶着墙根走了三步，摔在门槛上，哭了半声又笑起来。",
   "effects": {"health": 1, "story": "会走路了"}},
  {"id": "grab_test", "name": "抓周", "min_age": 1, "max_age": 1, "weight": 4, "cooldown": 99,
   "text": "抓周那天，你抓了算盘，父亲笑了，母亲说还早。",
   "effects": {"fame": 1}},
  {"id": "neighbor_dog", "name": "邻家犬", "min_age": 3, "max_age": 8, "weight": 2, "cooldown": 24,
   "text": "邻家黄狗追着你跑了半条巷子，裤脚咬破一个口。",
   "effects": {"health": -1, "story": "被狗追过"}},
  {"id": "lost_child", "name": "走失", "min_age": 3, "max_age": 8, "weight": 1, "cooldown": 60,
   "text": "赶集时你走丢了，站在卖糖人的摊子前哭，被邻村人送回来。",
   "effects": {"health": -1, "fame": 1, "story": "走丢过"}},
  {"id": "first_char", "name": "认字", "min_age": 5, "max_age": 10, "weight": 3, "cooldown": 12,
   "text": "你在沙地上把「人」字写了一遍又一遍，写歪了就用手抹平。",
   "effects": {"health": 0, "story": "认得字"}},
  {"id": "sicked_again", "name": "小病", "min_age": 2, "max_age": 9, "weight": 3, "cooldown": 18,
   "text": "入冬咳了半个月，母亲熬了梨汤，甜得发苦。",
   "effects": {"health": -2}},
  {"id": "help_harvest", "name": "帮工", "min_age": 7, "max_age": 14, "weight": 3, "cooldown": 12,
   "text": "你跟着大人下地，割了半日麦，手上起了泡。",
   "effects": {"money": 60, "health": -1}},
  {"id": "school_window", "name": "偷听", "min_age": 7, "max_age": 13, "weight": 2, "cooldown": 18,
   "text": "你趴在私塾窗下听蒙童念书，先生看了你一眼，没有赶你。",
   "effects": {"fame": 1, "story": "偷听过课"}},
  {"id": "steal_fruit", "name": "偷果", "min_age": 8, "max_age": 14, "weight": 2, "cooldown": 24,
   "text": "你偷摘了张家的枣，被逮住，母亲领你上门赔了不是。",
   "effects": {"money": -100, "fame": -2, "story": "偷过枣"}},
  {"id": "market_day", "name": "赶集", "min_age": 8, "weight": 3, "cooldown": 12,
   "text": "集上人声嗡嗡，卖布的、卖药的、算命的各占一角。",
   "effects": {"money": -80, "fame": 1}},
  {"id": "corvee", "name": "徭役", "min_age": 16, "max_age": 55, "weight": 3, "cooldown": 48,
   "text": "县里征夫修堤，你去了一个月，回来瘦了一圈。",
   "effects": {"health": -5, "money": 200, "fame": 1}},
  {"id": "land_dispute", "name": "田界", "min_age": 18, "max_age": 65, "weight": 2, "cooldown": 60,
   "text": "地界被人挪了半尺，你在田头站了半天，最后请里正来量。",
   "effects": {"money": -300, "fame": 1}},
  {"id": "caravan_join", "name": "随商队", "min_age": 18, "max_age": 50, "weight": 2, "cooldown": 48,
   "text": "你跟着商队走了趟邻州，路上见了山，也见了饿倒在路边的人。",
   "effects": {"money": 600, "health": -3}},
  {"id": "conscript", "name": "点兵", "min_age": 18, "max_age": 45, "weight": 1, "cooldown": 120,
   "text": "边关点兵，村里抽了三丁，你不在名册上，却一夜没睡。",
   "effects": {"health": -2, "story": "见过点兵"}},
  {"id": "neighbor_help", "name": "邻里相助", "min_age": 10, "weight": 3, "cooldown": 24,
   "text": "隔壁翻修屋顶，你去搭了半天手，回来时碗里多了两个鸡蛋。",
   "effects": {"fame": 2, "health": 1}},
  {"id": "bad_debt", "name": "讨债", "min_age": 20, "weight": 2, "cooldown": 60,
   "text": "有人上门讨一笔旧账，你翻遍箱子才算凑齐。",
   "effects": {"money": -400, "fame": -1}},
  {"id": "spouse_ill", "name": "妻病", "min_age": 22, "cond": "parent", "weight": 2, "cooldown": 60,
   "text": "妻子病了半个月，药钱比米钱还贵。",
   "effects": {"money": -500, "health": -2}},
  {"id": "child_fever", "name": "子病", "min_age": 25, "cond": "parent", "weight": 2, "cooldown": 48,
   "text": "孩子夜里发热，你抱着他在屋里走到天亮。",
   "effects": {"health": -3, "money": -200}},
  {"id": "old_wound", "name": "旧伤", "min_age": 45, "weight": 3, "cooldown": 36,
   "text": "年轻时落下的旧伤，一到阴雨天就疼。",
   "effects": {"health": -4}},
  {"id": "widowed", "name": "丧偶", "min_age": 50, "weight": 1, "cooldown": 200,
   "text": "相伴几十年的人先走了。屋里忽然安静得能听见风。",
   "effects": {"health": -5, "story": "丧偶"}},
  {"id": "grandchild_visit", "name": "孙辈", "min_age": 55, "cond": "parent", "weight": 2, "cooldown": 60,
   "text": "孙辈回来看你，围在膝下叫了一声，你应了半天才应出来。",
   "effects": {"health": 2, "fame": 2}},
  {"id": "village_elders", "name": "乡饮", "min_age": 60, "weight": 2, "cooldown": 60,
   "text": "乡里办饮宴，请你坐了上首，年轻人来敬酒，你只沾了沾唇。",
   "effects": {"fame": 4}},
  {"id": "last_winter", "name": "寒冬", "min_age": 65, "weight": 2, "cooldown": 36,
   "text": "这个冬天格外冷，你整日坐在灶边，想起很多年前的事。",
   "effects": {"health": -3}},
  {"id": "village_fire", "name": "火", "min_age": 12, "weight": 1, "cooldown": 200,
   "text": "夜里西头着了火，全村提着水桶去救，烧塌了两间屋。",
   "effects": {"money": -600, "health": -2}},
  {"id": "letter_home", "name": "家书", "min_age": 20, "weight": 2, "cooldown": 48,
   "text": "托人捎了封家书回去，写完才发现不知道该怎么落款。",
   "effects": {"fame": 1, "health": 1}},
  {"id": "old_friend_gone", "name": "故人", "min_age": 40, "weight": 2, "cooldown": 120,
   "text": "听说小时候的玩伴没了，你在门口站了一会儿，才想起他笑起来的样子。",
   "effects": {"health": -1, "story": "送走过故人"}}
]